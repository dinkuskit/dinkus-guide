#!/usr/bin/env node
import { answerQuestion, createOpenAICompatibleTransport } from "../src/guide.js";
import { syncCorpus, verifyCorpus } from "../src/corpus.js";

const VERSION = "1.0.0";
const args = process.argv.slice(2);
const json = args.includes("--json");
const modeAt = args.indexOf("--mode");
const mode = modeAt >= 0 ? args[modeAt + 1] : "extractive";
const positional = args.filter((arg, index) => arg !== "--json" && !(modeAt >= 0 && (index === modeAt || index === modeAt + 1)));

function help() {
  console.log(`DinkusGuide ${VERSION}
Usage:
  dinkus-guide corpus sync|verify [--json]
  dinkus-guide ask QUESTION [--json] [--mode extractive|model]
Exit codes: 0 success, 2 usage, 3 corpus unavailable/invalid, 4 model unavailable/invalid.`);
}

function output(value) {
  if (json) console.log(JSON.stringify(value));
  else {
    console.log(value.answer ?? `${value.status}: ${value.corpusHash ?? ""}`);
    for (const item of value.evidence ?? []) console.log(`\n[${item.sourceId} L${item.startLine}-${item.endLine}] ${item.url}\n${item.excerpt}`);
  }
}

try {
  if (args.includes("--help") || args.length === 0) { help(); process.exit(0); }
  if (args.includes("--version")) { console.log(VERSION); process.exit(0); }
  if (modeAt >= 0 && !["extractive", "model"].includes(mode)) throw Object.assign(new Error("mode must be extractive or model"), { code: 2 });
  if (positional[0] === "corpus" && ["sync", "verify"].includes(positional[1])) {
    if (positional.length !== 2) throw Object.assign(new Error("unexpected corpus arguments"), { code: 2 });
    const result = positional[1] === "sync" ? await syncCorpus() : await verifyCorpus();
    output({ status: "verified", corpusHash: result.corpusHash, sources: result.manifest.sources.length });
    process.exit(0);
  }
  if (positional[0] !== "ask" || positional.length < 2) throw Object.assign(new Error("expected ask QUESTION or corpus sync|verify"), { code: 2 });
  const question = positional.slice(1).join(" ");
  const corpus = await verifyCorpus();
  let transport;
  if (mode === "model") {
    transport = createOpenAICompatibleTransport({
      baseUrl: process.env.DINKUS_GUIDE_BASE_URL,
      model: process.env.DINKUS_GUIDE_MODEL || "nemotron-3.5-super-vl",
      apiKey: process.env.DINKUS_GUIDE_API_KEY
    });
  }
  output(await answerQuestion(question, corpus, { mode, transport }));
} catch (error) {
  const code = error.code ?? (mode === "model" ? 4 : 3);
  if (json) console.log(JSON.stringify({ status: "error", error: error.message }));
  else console.error(`dinkus-guide: ${error.message}`);
  process.exit(code);
}
