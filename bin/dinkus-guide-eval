#!/usr/bin/env node
import { realpathSync } from "node:fs";
import { readFile } from "node:fs/promises";
import { spawn } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);
const selfPath = realpathSync(fileURLToPath(import.meta.url));
const root = path.resolve(path.dirname(selfPath), "..");
const cli = path.join(root, "bin", "dinkus-guide");
const providerUnavailableError = /^(?:model mode requires configured provider|DINKUS_GUIDE_BASE_URL, MODEL, and API_KEY are required|the model alias is retired; use nemotron-3\.5-super-vl|model base URL must be credential-free HTTPS \(or loopback HTTP\)|invalid model base URL|model provider request failed|model provider unavailable \(HTTP \d+\))$/;

function isMainModule() {
  if (!process.argv[1]) return false;
  try {
    return selfPath === realpathSync(path.resolve(process.argv[1]));
  } catch {
    return false;
  }
}

function parseArgs() {
  const values = { json: false, mode: "extractive", modeSet: false, command: null };
  for (let index = 0; index < args.length; index += 1) {
    const arg = args[index];
    if (arg === "--json") { if (values.json) throw new Error("duplicate --json"); values.json = true; continue; }
    if (arg === "--mode") {
      if (values.modeSet || index + 1 >= args.length || args[index + 1].startsWith("-")) throw new Error("missing or duplicate --mode");
      values.modeSet = true; values.mode = args[++index]; continue;
    }
    if (arg.startsWith("-")) throw new Error(`unknown option: ${arg}`);
    if (values.command) throw new Error(`unexpected argument: ${arg}`);
    values.command = arg;
  }
  return values;
}

function runCli(cliArgs) {
  return new Promise((resolve) => {
    const child = spawn(process.execPath, [cli, ...cliArgs], { cwd: root, env: process.env });
    let stdout = "", stderr = "";
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.stderr.on("data", (chunk) => { stderr += chunk; });
    child.on("close", (code) => {
      let value;
      try { value = JSON.parse(stdout); } catch { value = { status: "error", error: "invalid CLI JSON" }; }
      resolve({ code, value, stderr: stderr.trim() });
    });
  });
}

function runGuide(question, mode) { return runCli(["ask", question, "--json", "--mode", mode]); }

export function evidenceForCitations(evidence, citations) {
  return (evidence ?? []).filter((item) => (citations ?? []).some((citation) =>
    citation.sourceId === item.sourceId &&
    citation.startLine === item.startLine &&
    citation.endLine === item.endLine));
}

if (isMainModule()) {
const jsonOutput = args.includes("--json");
const failUsage = (message) => {
  if (jsonOutput) console.log(JSON.stringify({ status: "error", error: message }));
  else console.error(`dinkus-guide-eval: ${message}`);
  process.exit(2);
};
let options;
try { options = parseArgs(); } catch (error) { failUsage(error.message); }
if (!args.length) {
  console.log("Usage: dinkus-guide-eval run [--json] [--mode extractive|model]");
  process.exit(0);
}
if (options.command === null) failUsage("expected command: run");
if (options.command !== "run") failUsage(`unexpected command: ${options.command}`);
if (!["extractive", "model"].includes(options.mode)) failUsage("mode must be extractive or model");

const suite = JSON.parse(await readFile(path.join(root, "eval", "cases.json"), "utf8"));
const corpusRun = await runCli(["corpus", "verify", "--json"]);
if (corpusRun.code !== 0) {
  const report = { suite: suite.suite, suiteVersion: suite.version, mode: options.mode, availability: "unavailable",
    reason: corpusRun.value.error || corpusRun.stderr, total: suite.cases.length, passed: 0, score: null, results: [] };
  console.log(options.json ? JSON.stringify(report) : `unavailable: ${report.reason}`);
  process.exit(2);
}

const results = [];
const modelIdentities = new Set();
for (const test of suite.cases) {
  const run = await runGuide(test.question, options.mode);
  const value = run.value;
  if (value.modelIdentity) modelIdentities.add(value.modelIdentity);
  if (options.mode === "model" && run.code === 4 && providerUnavailableError.test(value.error || "")) {
    const report = { suite: suite.suite, suiteVersion: suite.version, mode: options.mode, availability: "unavailable",
      reason: value.error, total: suite.cases.length, passed: 0, score: null, results: [] };
    console.log(options.json ? JSON.stringify(report) : `unavailable: ${report.reason}`);
    process.exit(2);
  }
  const citations = value.citations ?? [];
  const citedIds = [...new Set(citations.map((citation) => citation.sourceId))];
  const citedEvidence = evidenceForCitations(value.evidence, citations);
  const answerText = (value.answer ?? "").replace(test.question, "");
  const searchable = `${answerText}\n${citedEvidence.map((item) => item.excerpt).join("\n")}`.toLowerCase().replace(/\s+/g, " ");
  const facts = test.facts.filter((fact) => searchable.includes(fact.toLowerCase().replace(/\s+/g, " ")));
  const requiredSources = test.sources.filter((source) => citedIds.includes(source));
  const citationPass = test.abstain ? citedIds.length === 0 : requiredSources.length === test.sources.length;
  const abstentionPass = test.abstain ? value.status === "insufficient_evidence" : value.status === "answered";
  const exitPass = run.code === 0;
  results.push({ id: test.id, status: value.status ?? "error", factsMatched: facts.length, factsRequired: test.facts.length,
    citationsMatched: requiredSources.length, citationsRequired: test.abstain ? 0 : test.sources.length,
    abstentionPass, citationPass, exitCode: run.code, pass: exitPass && facts.length === test.facts.length && citationPass && abstentionPass });
}
const passed = results.filter((result) => result.pass).length;
const report = { suite: suite.suite, suiteVersion: suite.version, mode: options.mode, availability: "available",
  modelIdentity: options.mode === "model" ? [...modelIdentities] : undefined, corpusHash: corpusRun.value.corpusHash ?? null,
  total: results.length, passed, score: passed / results.length, results };
if (options.json) console.log(JSON.stringify(report));
else console.log(`${passed}/${results.length} passed (${(report.score * 100).toFixed(1)}%) in ${options.mode} mode`);
process.exit(passed === results.length ? 0 : 1);
}
