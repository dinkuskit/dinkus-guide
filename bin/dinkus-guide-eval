#!/usr/bin/env node
import { createHash } from "node:crypto";
import { realpathSync } from "node:fs";
import { readFile } from "node:fs/promises";
import { spawn } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);
const selfPath = realpathSync(fileURLToPath(import.meta.url));
const root = path.resolve(path.dirname(selfPath), "..");
const cli = path.join(root, "bin", "dinkus-guide");
const providerUnavailableError = /^(?:model mode requires configured provider|DINKUS_GUIDE_BASE_URL, MODEL, and API_KEY are required|the model alias is retired; use nemotron-3\.5-super-vl|model base URL must be credential-free HTTPS \(or loopback HTTP\)|invalid model base URL|model provider request failed|model provider unavailable \(HTTP \d+\)|DINKUS_GUIDE_EMBED_BASE_URL and EMBED_MODEL are required|DINKUS_GUIDE_EMBED_API_KEY is required for non-loopback HTTPS embedding endpoints|embedding base URL must be credential-free HTTPS \(or loopback HTTP\)|invalid embedding base URL|embedding provider request failed|embedding provider unavailable \(HTTP \d+\)|corpus embeddings cache is (?:missing|out of date for current chunking); run corpus sync with embedding configuration)$/;

export const ALLOWED_CATEGORIES = new Set([
  "lookup",
  "workflow",
  "transition_trap",
  "cross_plugin",
  "honest_abstention",
  "boundary_refusal"
]);

export const APPROVED_EVAL_REPOSITORIES = [
  "dinkuskit/dinkuskit",
  "dinkuskit/commerce",
  "dinkuskit/payments",
  "dinkuskit/inventory",
  "dinkuskit/ship",
  "dinkuskit/template-store",
  "emdash-cms/emdash"
];

export const FAILURE_BUCKETS = [
  "retrieval_miss",
  "schema_error",
  "abstention_error",
  "citation_miss",
  "fact_miss"
];

function isMainModule() {
  if (!process.argv[1]) return false;
  try {
    return selfPath === realpathSync(path.resolve(process.argv[1]));
  } catch {
    return false;
  }
}

function normalizeText(value) {
  return String(value ?? "").toLowerCase().replace(/\s+/g, " ").trim();
}

function sha256Text(value) {
  return createHash("sha256").update(value, "utf8").digest("hex");
}

function emptyBucketCounts() {
  return {
    retrieval_miss: 0,
    schema_error: 0,
    abstention_error: 0,
    citation_miss: 0,
    fact_miss: 0
  };
}

function parseArgs(rawArgs = args) {
  const values = {
    json: false,
    summaryOnly: false,
    mode: "extractive",
    modeSet: false,
    k: 12,
    kSet: false,
    suite: null,
    suiteSet: false,
    checkDisjoint: [],
    command: null
  };
  for (let index = 0; index < rawArgs.length; index += 1) {
    const arg = rawArgs[index];
    if (arg === "--json") { if (values.json) throw new Error("duplicate --json"); values.json = true; continue; }
    if (arg === "--summary-only") { if (values.summaryOnly) throw new Error("duplicate --summary-only"); values.summaryOnly = true; continue; }
    if (arg === "--mode") {
      if (values.modeSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --mode");
      values.modeSet = true; values.mode = rawArgs[++index]; continue;
    }
    if (arg === "--k") {
      if (values.kSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --k");
      values.kSet = true;
      const parsedK = Number(rawArgs[++index]);
      if (!Number.isInteger(parsedK) || parsedK < 1 || parsedK > 50) throw new Error("k must be an integer between 1 and 50");
      values.k = parsedK;
      continue;
    }
    if (arg === "--suite") {
      if (values.suiteSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --suite");
      values.suiteSet = true;
      values.suite = rawArgs[++index];
      continue;
    }
    if (arg === "--check-disjoint") {
      if (index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing --check-disjoint path");
      values.checkDisjoint.push(rawArgs[++index]);
      continue;
    }
    if (arg.startsWith("-")) {
      throw new Error(values.summaryOnly || rawArgs.includes("--summary-only") ? "unknown CLI option" : `unknown option: ${arg}`);
    }
    if (values.command) {
      throw new Error(values.summaryOnly || rawArgs.includes("--summary-only") ? "unexpected positional argument" : `unexpected argument: ${arg}`);
    }
    values.command = arg;
  }
  return values;
}

function isInsideRoot(resolvedPath) {
  let target = resolvedPath;
  try { target = realpathSync(resolvedPath); } catch { /* ignore missing path before readFile */ }
  const rel = path.relative(root, target).replace(/\\/g, "/");
  return Boolean(rel && !rel.startsWith("..") && !path.isAbsolute(rel)) ? rel : null;
}

function sanitizeSuiteLabel(resolvedPath, { redactExternal = false } = {}) {
  const rel = isInsideRoot(resolvedPath);
  if (rel) return rel;
  if (redactExternal) return "<external-suite>";
  let target = resolvedPath;
  try { target = realpathSync(resolvedPath); } catch { /* ignore missing path before readFile */ }
  return path.basename(target);
}

export function verifySuiteStratification(label, suite, {
  minCases,
  maxCases,
  expectedRole,
  sourceRepositories = null,
  requiredRepositories = APPROVED_EVAL_REPOSITORIES,
  redactCaseDetails = false
} = {}) {
  const safeLabel = redactCaseDetails ? "<external-suite>" : label;
  if (expectedRole && suite.role !== expectedRole) {
    throw new Error(`${safeLabel} must declare role="${expectedRole}"`);
  }
  if (minCases !== undefined && maxCases !== undefined) {
    if (suite.cases.length < minCases || suite.cases.length > maxCases) {
      throw new Error(`${safeLabel} must contain ${minCases}-${maxCases} cases (got ${suite.cases.length})`);
    }
  }
  if (suite.role === "locked_promotion_exam") {
    if (typeof suite.policy !== "string" || !/Rung 3/i.test(suite.policy) || !/Rung 4/i.test(suite.policy)) {
      throw new Error(`${safeLabel} must declare its Rung 3 / Rung 4 locked promotion exam policy`);
    }
  }
  const categories = new Set(suite.cases.map((item) => item.category));
  for (const cat of ALLOWED_CATEGORIES) {
    if (!categories.has(cat)) {
      throw new Error(`${safeLabel} is missing required category: ${cat}`);
    }
  }
  if (sourceRepositories) {
    const coveredRepos = new Set();
    for (const item of suite.cases) {
      for (const src of [...(item.sources ?? []), ...(item.anyOfSources ?? []).flat()]) {
        const entry = sourceRepositories.get(src);
        const repo = typeof entry === "string" ? entry : entry?.repository;
        if (repo) coveredRepos.add(repo);
      }
    }
    for (const repo of requiredRepositories) {
      if (!coveredRepos.has(repo)) {
        throw new Error(`${safeLabel} is missing repository coverage for ${repo}`);
      }
    }
  }
  return true;
}

export function assertSuitesDisjoint(primarySuite, referenceSuite, {
  primaryLabel = primarySuite?.suite ?? "primary",
  referenceLabel = referenceSuite?.suite ?? "reference",
  redactCaseDetails = false
} = {}) {
  if (!primarySuite?.cases || !referenceSuite?.cases) {
    throw new Error("both suites must provide cases arrays for disjointness verification");
  }
  const refIds = new Set(referenceSuite.cases.map((item) => item.id));
  const refQuestions = new Set(referenceSuite.cases.map((item) => normalizeText(item.question)));
  for (const item of primarySuite.cases) {
    if (refIds.has(item.id)) {
      throw new Error(
        redactCaseDetails
          ? "duplicate case id detected across compared suites"
          : `duplicate case id across ${primaryLabel} and ${referenceLabel}: ${item.id}`
      );
    }
    if (refQuestions.has(normalizeText(item.question))) {
      throw new Error(
        redactCaseDetails
          ? "duplicate question detected across compared suites"
          : `duplicate question across ${primaryLabel} and ${referenceLabel}: ${item.id}`
      );
    }
  }
  return true;
}

export function validateSuite(suite, {
  manifestIds = null,
  sourceRepositories = null,
  requireCategories = false,
  redactCaseDetails = false
} = {}) {
  if (!suite || typeof suite !== "object" || Array.isArray(suite)) {
    throw new Error("evaluation suite must be a JSON object");
  }
  if (!Number.isInteger(suite.version) || suite.version < 1) {
    throw new Error("evaluation suite requires integer version >= 1");
  }
  if (typeof suite.suite !== "string" || !suite.suite.trim()) {
    throw new Error("evaluation suite requires a non-empty suite identifier");
  }
  if (!Array.isArray(suite.cases) || !suite.cases.length) {
    throw new Error("evaluation suite requires a non-empty cases array");
  }
  const enforceV4 = requireCategories || suite.version >= 4 || suite.role === "locked_promotion_exam";
  const seenIds = new Set();
  const seenQuestions = new Set();

  for (const item of suite.cases) {
    if (!item || typeof item !== "object" || Array.isArray(item)) {
      throw new Error("each evaluation case must be an object");
    }
    if (typeof item.id !== "string" || !item.id.trim()) {
      throw new Error("evaluation case requires a non-empty id");
    }
    if (seenIds.has(item.id)) {
      throw new Error(redactCaseDetails ? "duplicate evaluation case id" : `duplicate evaluation case id: ${item.id}`);
    }
    seenIds.add(item.id);
    const casePrefix = redactCaseDetails ? "suite case" : `case ${item.id}`;

    if (typeof item.question !== "string" || !item.question.trim()) {
      throw new Error(`${casePrefix}: question must be non-empty`);
    }
    const normalizedQuestion = normalizeText(item.question);
    if (seenQuestions.has(normalizedQuestion)) {
      throw new Error(`${casePrefix}: duplicate question text`);
    }
    seenQuestions.add(normalizedQuestion);

    if (typeof item.abstain !== "boolean") {
      throw new Error(`${casePrefix}: abstain must be boolean`);
    }
    if (item.expectedStatus !== undefined) {
      const expectedForAbstain = item.abstain ? "insufficient_evidence" : "answered";
      if (item.expectedStatus !== expectedForAbstain) {
        throw new Error(`${casePrefix}: expectedStatus must match abstain (${expectedForAbstain})`);
      }
    }
    if (enforceV4 || item.category !== undefined) {
      if (!ALLOWED_CATEGORIES.has(item.category)) {
        throw new Error(`${casePrefix}: invalid or missing category`);
      }
      const isAbstentionCategory = item.category === "honest_abstention" || item.category === "boundary_refusal";
      if (item.abstain !== isAbstentionCategory) {
        throw new Error(
          redactCaseDetails
            ? `${casePrefix}: category disagrees with abstain=${item.abstain}`
            : `${casePrefix}: category ${item.category} disagrees with abstain=${item.abstain}`
        );
      }
    }

    if (!Array.isArray(item.facts) || item.facts.some((fact) => typeof fact !== "string" || !fact.trim())) {
      throw new Error(`${casePrefix}: facts must be an array of non-empty strings`);
    }
    if (!item.abstain && enforceV4 && item.facts.length < 2) {
      throw new Error(`${casePrefix}: answerable v4 cases require at least 2 specific facts`);
    }

    if (item.forbiddenFacts !== undefined) {
      if (!Array.isArray(item.forbiddenFacts) || item.forbiddenFacts.some((fact) => typeof fact !== "string" || !fact.trim())) {
        throw new Error(`${casePrefix}: forbiddenFacts must be an array of non-empty strings`);
      }
    }

    const sources = item.sources ?? [];
    if (!Array.isArray(sources) || sources.some((src) => typeof src !== "string" || !src.trim())) {
      throw new Error(`${casePrefix}: sources must be an array of source IDs`);
    }
    const anyOfSources = item.anyOfSources ?? [];
    if (!Array.isArray(anyOfSources) || anyOfSources.some((group) =>
      !Array.isArray(group) || !group.length || group.some((src) => typeof src !== "string" || !src.trim())
    )) {
      throw new Error(`${casePrefix}: anyOfSources must be an array of non-empty source ID arrays`);
    }

    if (item.abstain && (sources.length > 0 || anyOfSources.length > 0)) {
      throw new Error(`${casePrefix}: abstention cases cannot require sources or anyOfSources`);
    }
    if (!item.abstain && sources.length + anyOfSources.length === 0) {
      throw new Error(`${casePrefix}: answerable cases require sources or anyOfSources`);
    }

    if (manifestIds) {
      for (const src of [...sources, ...anyOfSources.flat()]) {
        if (!manifestIds.has(src)) {
          throw new Error(redactCaseDetails ? `${casePrefix}: unknown corpus sourceId` : `${casePrefix}: unknown corpus sourceId ${src}`);
        }
      }
    }
  }

  if (suite.role === "locked_promotion_exam") {
    verifySuiteStratification(suite.suite, suite, {
      minCases: 25,
      maxCases: 30,
      expectedRole: "locked_promotion_exam",
      sourceRepositories,
      redactCaseDetails
    });
  }
  return suite;
}

export async function loadCorpusSources(rootDir = root) {
  const manifest = JSON.parse(await readFile(path.join(rootDir, "corpus", "manifest.json"), "utf8"));
  const map = new Map();
  for (const source of manifest.sources ?? []) {
    const file = path.join(rootDir, ".cache", "dinkus-guide", "sources", `${source.id}.md`);
    const text = await readFile(file, "utf8");
    map.set(source.id, {
      id: source.id,
      repository: source.repository ?? "",
      layer: source.layer ?? (source.repository === "emdash-cms/emdash" ? "emdash" : "dinkuskit"),
      status: source.status ?? "active",
      lines: text.split(/\r?\n/)
    });
  }
  return map;
}

function runCli(cliArgs) {
  return new Promise((resolve) => {
    const child = spawn(process.execPath, [cli, ...cliArgs], { cwd: root, env: process.env });
    let stdout = "", stderr = "";
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.stderr.on("data", (chunk) => { stderr += chunk; });
    child.on("close", (code) => {
      let value;
      try { value = JSON.parse(stdout); } catch { value = { status: "error", error: "invalid CLI JSON" }; }
      resolve({ code, value, stderr: stderr.trim() });
    });
  });
}

function runGuide(question, mode, limit = 12) {
  const cliArgs = ["ask", question, "--json", "--mode", mode];
  if (limit !== 12) cliArgs.push("--limit", String(limit));
  return runCli(cliArgs);
}

export function evidenceForCitations(evidence, citations) {
  return (evidence ?? []).filter((item) => (citations ?? []).some((citation) =>
    citation.sourceId === item.sourceId &&
    citation.startLine === item.startLine &&
    citation.endLine === item.endLine));
}

function matchSourcesAndGroups(test, candidateIds) {
  const mandatorySources = test.sources ?? [];
  const sourceGroups = test.anyOfSources ?? [];
  const mandatoryMatched = mandatorySources.filter((source) => candidateIds.includes(source)).length;
  const groupsMatched = sourceGroups.filter((group) => group.some((source) => candidateIds.includes(source))).length;
  const matched = mandatoryMatched + groupsMatched;
  const required = mandatorySources.length + sourceGroups.length;
  return {
    mandatoryMatched,
    mandatoryRequired: mandatorySources.length,
    groupsMatched,
    groupsRequired: sourceGroups.length,
    matched,
    required,
    satisfied: matched === required
  };
}

export function computeRecallCase(test, evidence, k = 12) {
  const topEvidence = (evidence ?? []).slice(0, k);
  const retrievedIds = [...new Set(topEvidence.map((item) => item.sourceId))];
  const sourceMatch = matchSourcesAndGroups(test, retrievedIds);
  const searchable = normalizeText(topEvidence.map((item) => item.excerpt).join("\n"));
  const factsList = test.facts ?? [];
  const factsInEvidence = factsList.filter((fact) => searchable.includes(normalizeText(fact))).length;
  const sourceHit = sourceMatch.satisfied;
  const spanFactHit = factsInEvidence === factsList.length;
  const hit = sourceHit && spanFactHit;
  return {
    id: test.id,
    ...(test.category ? { category: test.category } : {}),
    k,
    sourcesMatched: sourceMatch.matched,
    sourcesRequired: sourceMatch.required,
    groupsMatched: sourceMatch.groupsMatched,
    groupsRequired: sourceMatch.groupsRequired,
    factsInEvidence,
    factsRequired: factsList.length,
    sourceHit,
    spanFactHit,
    hit,
    failureBucket: hit ? null : "retrieval_miss"
  };
}

export function verifyCitationSpan(citation, corpusSources = null) {
  if (!citation || typeof citation !== "object") {
    return { valid: false, reason: "malformed_citation" };
  }
  if (typeof citation.sourceId !== "string" || !citation.sourceId.trim()) {
    return { valid: false, reason: "missing_source_id" };
  }
  if (!Number.isInteger(citation.startLine) || citation.startLine < 1 ||
      !Number.isInteger(citation.endLine) || citation.endLine < citation.startLine) {
    return { valid: false, reason: "invalid_line_range" };
  }
  if (!corpusSources) {
    return { valid: true, text: null };
  }
  const doc = corpusSources.get(citation.sourceId);
  if (!doc) {
    return { valid: false, reason: "unknown_source_id" };
  }
  if (citation.endLine > doc.lines.length) {
    return { valid: false, reason: "line_out_of_bounds" };
  }
  return {
    valid: true,
    text: doc.lines.slice(citation.startLine - 1, citation.endLine).join("\n")
  };
}

const CORPUS_NOUN_PATTERN = "(?:corpus|sources?|documents?|documentation|docs|evidence|excerpts?|passages?|files?|charters?|manifest|contracts?|context|materials?|references?)";
const CORPUS_MOD_PATTERN = "(?:(?:pinned|provided|available|public|retrieved|current)\\s+)*";
const LEADING_CORPUS_FRAME_PATTERN = `(?:(?:based\\s+on|according\\s+to|in|within|across)\\s+(?:the\\s+|these\\s+)?${CORPUS_MOD_PATTERN}${CORPUS_NOUN_PATTERN}\\s*,\\s*)?`;
const GUIDE_SUBJECT_PATTERN = `(?:dinkusguide|dinkus-guide|(?:this|the)\\s+(?:(?:optional|read-only|text-only|public(?:-source)?|documentation)\\s+)*guide|i)`;
const CORPUS_SUBJECT_PATTERN = `(?:(?:the\\s+|these\\s+)?${CORPUS_MOD_PATTERN}${CORPUS_NOUN_PATTERN})`;

const ABSTENTION_BUILTIN_GUIDANCE_SENTENCE_RE = /^provide\s+a\s+documented\s+text\s+contract\s+or\s+consult\s+the\s+pinned\s+(?:public\s+)?sources[.!?]?$/i;

const ABSTENTION_EXPLICIT_SUBJECT_TAIL_RE = new RegExp(
  `^${LEADING_CORPUS_FRAME_PATTERN}(?:(?<guideSubject>${GUIDE_SUBJECT_PATTERN})|(?<corpusSubject>${CORPUS_SUBJECT_PATTERN}))(?:\\s+in\\s+v1)?\\s+(?<tail>.+)$`,
  "i"
);
const ABSTENTION_ANAPHORIC_SUBJECT_TAIL_RE = new RegExp(
  `^${LEADING_CORPUS_FRAME_PATTERN}(?:(?<guideSubject>${GUIDE_SUBJECT_PATTERN})|(?<corpusSubject>${CORPUS_SUBJECT_PATTERN})|(?<itSubject>it))(?:\\s+in\\s+v1)?\\s+(?<tail>.+)$`,
  "i"
);

const ABSTENTION_THERE_ABSENCE_CLAUSE_RE = new RegExp(
  `^${LEADING_CORPUS_FRAME_PATTERN}there\\s+(?:is|are)\\s+(?:no|not\\s+enough|insufficient)\\s+` +
  `(?:(?:(?:documented|public|pinned|verified|available|explicit)\\s+)*(?:evidence|documentation|information|mentions?|sources?)|` +
  `(?:documented|public|pinned)\\s+(?:support|details|instructions))` +
  `(?:\\s+(?<prep>in|within|across|for|about|on|to)\\s+(?<tail>.+?))?[.!?]?$`,
  "i"
);

const ABSTENTION_BARE_ABSENCE_CLAUSE_RE = new RegExp(
  `^${LEADING_CORPUS_FRAME_PATTERN}(?:insufficient|no)\\s+` +
  `(?:(?:(?:documented|public|pinned|verified|available|explicit)\\s+)*(?:evidence|documentation|information)|` +
  `(?:documented|public|pinned)\\s+(?:support|details|instructions))` +
  `(?:\\s+(?:is|are)\\s+(?:available|provided|present|found|included|documented)(?:\\s+(?<prepA>in|within|across|for|about|on|to)\\s+(?<tailA>.+?))?|` +
  `\\s+exists?(?:\\s+(?<prepB>in|within|across|for|about|on|to)\\s+(?<tailB>.+?))?|` +
  `\\s+(?<prepC>in|within|across|for|about|on|to)\\s+(?<tailC>.+?))?[.!?]?$`,
  "i"
);

const ABSTENTION_PASSIVE_TOPIC_CLAUSE_RE = new RegExp(
  `^${LEADING_CORPUS_FRAME_PATTERN}(?<topic>[A-Za-z0-9"\`][A-Za-z0-9/@_'"\` -]*(?:\\.[A-Za-z0-9_-]+[A-Za-z0-9/@_'"\` -]*)*?)\\s+(?:is|are)\\s+` +
  `(?:not\\s+(?:yet\\s+|currently\\s+)?(?:documented|supported|present|provided|available|mentioned|covered|included|built|implemented|specified|found|decided)|` +
  `unverified|unsupported|undocumented|unbuilt|undecided|(?:(?:a|an)\\s+)?(?:(?:unbuilt|future)\\s+)?target\\s+direction|(?:an\\s+)?open\\s+decision)` +
  `(?:\\s+(?:in|by|within|across)\\s+(?:the\\s+)?${CORPUS_MOD_PATTERN}(?:${CORPUS_NOUN_PATTERN}|v1))?[.!?]?$`,
  "i"
);

const ABSTENTION_SENSITIVE_TOPIC_HEAD_RE = /\b(?:customers?|buyers?|merchants?|tenants?|accounts?|orders?|databases?|records?|histories|history|stores?|production|data)\s*$/i;

const ABSTENTION_CLAUSE_HARD_PIVOT_RE = /[;:—–]|\s--\s|\b(?:but|however|although|though|nevertheless|meanwhile|whereas|while|because|since|unless)\b|,\s*yet\b|,\s*instead\b|\binstead\s*,|,\s*except\b|\bexcept\s+that\b|,\s*with\b/i;

const ABSTENTION_AUXILIARY_RE = /\b(?:is|are|was|were|am|be|been|has|have|had|does|do|did|can|cannot|can't|could|will|won't|would|should|may|might|must)\b/i;

const ABSTENTION_FINITE_VERB_RE = /\b(?:is|are|was|were|am|be|been|has|have|had|does|do|did|can|cannot|can't|could|will|won't|would|should|may|might|must|allows?|performs?|executes?|refuses?|forbids?|supports|implements?|contains?|includes?|provides?|covers|describes?|mentions?|specifies|specify|defines?|addresses|applies|discusses|explains?|indicates?|shows?|confirms?|modifies|modify|mutates?|edits?|commits?|deletes?|deploys?|exports?|exposes?|lives?|works?|uses?|runs|resides?|owes?|paid|bought|ordered|(?:answers|documents|states)\s+(?:a|an|the|this|that|these|those|all|any|[A-Za-z]{3,}))\b/i;

const ABSTENTION_COORDINATED_VERB_START_RE = /^(?:is|are|was|were|am|be|been|has|have|had|does|do|did|can|cannot|can't|could|will|won't|would|should|may|might|must|allows?|performs?|executes?|refuses?|forbids?|implements?|contains?|includes?|provides?|describes?|specifies|specify|defines?|applies|apply|discusses|explains?|indicates?|shows?|confirms?|modifies|modify|mutates?|edits?|commits?|deletes?|deploys?|exports?|exposes?|lives?|works?|uses?|resides?|owes?|paid|bought|ordered|(?:supports?|covers?|mentions?|addresses|runs?|documents?|states?|answers?)\s+(?:a|an|the|this|that|these|those|all|any|live|automated|manual|[A-Za-z]{3,}))\b/i;

const ABSTENTION_BARE_INFINITIVE_START_RE = /^(?:access|address|allow|answer|change|commit|confirm|configure|consult|contain|cover|define|delete|deploy|describe|detail|discuss|document|edit|execute|explain|export|expose|find|forge|have|implement|include|indicate|inspect|mention|modify|mutate|perform|prove|provide|retrieve|run|show|specify|state|support|sync|use|verify|view|write)\b/i;

const ABSTENTION_COMPLEMENT_NEGATION_RE = /\b(?:not|never|no|neither|none|nothing|without|lack|lacks|lacking|missing|unable|cannot|can't|won't)\b/i;
const ABSTENTION_COMPLEMENT_FINITE_AUX_RE = /\b(?:is|are|was|were|am|been|being|has|had|does|do|did|can|cannot|can't|could|will|won't|would|should|may|might|must)\b/i;
const ABSTENTION_COMPLEMENT_3SG_VERB_RE = /\b(?:allows|performs|executes|refuses|forbids|implements|contains|includes|provides|describes|specifies|defines|applies|discusses|explains|indicates|shows|confirms|modifies|mutates|edits|commits|deletes|deploys|exports|exposes|lives|works|uses|resides|owes)\b/i;
const ABSTENTION_COMPLEMENT_SUBORDINATE_RE = /\b(?:whether|if)\b|\bthat\s+(?!question\b|version\b|feature\b|topic\b|capability\b|integration\b|configuration\b|workflow\b|command\b|endpoint\b|request\b|setting\b)/i;
const ABSTENTION_PLURAL_SUBJECT_VERB_RE = /\b(?:plugins|connectors|adapters|packages|modules|services|systems|models|endpoints|commands|tools|integrations|features|sources|documents|files|contracts|charters|secrets|keys)\s+(?:allow|perform|execute|refuse|forbid|support|implement|contain|include|provide|cover|describe|mention|specify|define|address|apply|discuss|explain|indicate|show|confirm|modify|mutate|edit|commit|delete|deploy|export|expose|use|run|access|change|configure|sync|verify|prove|state|write)\b/i;
const ABSTENTION_POSTPOSITIVE_PREDICATE_ITEM_RE = /\s+\b(?:available|enabled|present|supported|documented|included|permitted|allowed|authorized|configured|implemented|built|verified|found|shown|exposed|public|optional)\s*$/i;

const ABSTENTION_ALLOWED_CHARS_RE = /^[A-Za-z0-9 .,!?;:'"`()/@_\r\n-]+$/;

const ABSTENTION_DOUBLE_NEGATION_RE = /\b(?:cannot|can't|won't|(?:can|could|will|would|should|may|might|must|does|do|did|is|are|was|were|am|has|have|had)\s+not)\s+(?:not|never)\b|\b(?:not|never|no)\s+(?:unable|missing|lacking|lack|without|unsupported|undocumented|unbuilt|unavailable|unverified|forbidden|prohibited|restricted|blocked)\b|\b(?:(?:is|are|was|were|am)\s+not|(?:cannot|can't|won't|(?:can|could|will|would|should|may|might|must|does|do|did)\s+not)\s+(?:have\s+to\s+)?be)\s+(?:(?:a|an|the|currently|still|strictly|solely|merely|just|only|optional)\s+)*(?:read[\s-]+only|text[\s-]+only|optional|public(?:-source)?|scoped)\b|\b(?:does|do|did|will|won't|can|cannot|can't|could|would|should|may|might|must)\s+(?:not\s+)?(?:refuse|forbid)\b|\b(?:lacks?|without|no|(?:cannot|can't|won't|(?:can|could|will|would|should|may|might|must|does|do|did|has|have|had)\s+not)\s+have)\s+(?:any\s+|a\s+|an\s+|the\s+)?(?:boundaries|boundary|rules?|policies|policy|restrictions?|read[\s-]+only|text[\s-]+only)\b/i;

const ABSTENTION_EMBEDDED_CLAIM_RE = /\b(?:that|whether|where|when|if)\s+(?!(?:dinkusguide|dinkus-guide|(?:this|the)\s+guide|it)\b)[A-Za-z0-9/@_' -]{1,80}?\s+\b(?:is|are|was|were|has|have|had|does|do|did|can|cannot|can't|will|won't|would|should|may|might|must|contains?|includes?|holds?|stores?|shows?|exports?|lives?|works?|owes?|paid|ordered)\b/i;

const ABSTENTION_DISALLOWED_CONTENT_RE = /```|https?:\/\/|(?:^|\n)\s*(?:[-*]\s+|\d+[.)]\s+|step\s+\d+\b)|\$\s*\d+|\b[A-Z][A-Z0-9_]{2,}\s*=|\b(?:wrangler|pnpm|npm|npx|curl|git)\s+(?:deploy|secret|push|commit|install|add|exec|run)\b|\b(?:typically\s+you|workaround|try\s+running|here\s+(?:is|are)\s+(?:how|the|your|a\s+sample))\b|\b(?:i\s+(?:have\s+)?(?:deployed|edited|created|deleted|exported|updated|executed|inspected|retrieved)|order\s+#\d+|sk_(?:live|test)_[A-Za-z0-9_]*|whsec_[A-Za-z0-9_]*|ec_pat_[A-Za-z0-9_]*|dk_store_[A-Za-z0-9_]*|Bearer\s+[A-Za-z0-9._-]{6,})\b|\b\d+\s+[A-Z][a-z]+(?:\s+[A-Z][a-z]+)?\s+(?:St(?:reet)?|Ave(?:nue)?|Rd|Road|Blvd|Boulevard|Dr(?:ive)?|Ln|Lane|Way|Ct|Court|Pl(?:ace)?)\b|\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}\b|\b\d{3}-\d{2}-\d{4}\b/i;

const TOPIC_FUNCTION_WORDS = new Set(["a", "an", "the", "this", "that", "these", "those", "and", "or", "of", "in", "for", "to", "with", "on", "by", "from"]);

