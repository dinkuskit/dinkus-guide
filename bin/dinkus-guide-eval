#!/usr/bin/env node
import { createHash } from "node:crypto";
import { realpathSync } from "node:fs";
import { readFile } from "node:fs/promises";
import { spawn } from "node:child_process";
import path from "node:path";
import { fileURLToPath } from "node:url";

const args = process.argv.slice(2);
const selfPath = realpathSync(fileURLToPath(import.meta.url));
const root = path.resolve(path.dirname(selfPath), "..");
const cli = path.join(root, "bin", "dinkus-guide");
const providerUnavailableError = /^(?:model mode requires configured provider|DINKUS_GUIDE_BASE_URL, MODEL, and API_KEY are required|the model alias is retired; use nemotron-3\.5-super-vl|model base URL must be credential-free HTTPS \(or loopback HTTP\)|invalid model base URL|model provider request failed|model provider unavailable \(HTTP \d+\)|DINKUS_GUIDE_EMBED_BASE_URL and EMBED_MODEL are required|DINKUS_GUIDE_EMBED_API_KEY is required for non-loopback HTTPS embedding endpoints|embedding base URL must be credential-free HTTPS \(or loopback HTTP\)|invalid embedding base URL|embedding provider request failed|embedding provider unavailable \(HTTP \d+\)|corpus embeddings cache is (?:missing|out of date for current chunking); run corpus sync with embedding configuration)$/;

export const ALLOWED_CATEGORIES = new Set([
  "lookup",
  "workflow",
  "transition_trap",
  "cross_plugin",
  "honest_abstention",
  "boundary_refusal"
]);

export const APPROVED_EVAL_REPOSITORIES = [
  "dinkuskit/dinkuskit",
  "dinkuskit/commerce",
  "dinkuskit/payments",
  "dinkuskit/inventory",
  "dinkuskit/ship",
  "dinkuskit/template-store",
  "emdash-cms/emdash"
];

export const FAILURE_BUCKETS = [
  "retrieval_miss",
  "schema_error",
  "abstention_error",
  "citation_miss",
  "fact_miss"
];

function isMainModule() {
  if (!process.argv[1]) return false;
  try {
    return selfPath === realpathSync(path.resolve(process.argv[1]));
  } catch {
    return false;
  }
}

function normalizeText(value) {
  return String(value ?? "").toLowerCase().replace(/\s+/g, " ").trim();
}

function sha256Text(value) {
  return createHash("sha256").update(value, "utf8").digest("hex");
}

function emptyBucketCounts() {
  return {
    retrieval_miss: 0,
    schema_error: 0,
    abstention_error: 0,
    citation_miss: 0,
    fact_miss: 0
  };
}

function parseArgs(rawArgs = args) {
  const values = {
    json: false,
    summaryOnly: false,
    mode: "extractive",
    modeSet: false,
    k: 12,
    kSet: false,
    suite: null,
    suiteSet: false,
    checkDisjoint: [],
    command: null
  };
  for (let index = 0; index < rawArgs.length; index += 1) {
    const arg = rawArgs[index];
    if (arg === "--json") { if (values.json) throw new Error("duplicate --json"); values.json = true; continue; }
    if (arg === "--summary-only") { if (values.summaryOnly) throw new Error("duplicate --summary-only"); values.summaryOnly = true; continue; }
    if (arg === "--mode") {
      if (values.modeSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --mode");
      values.modeSet = true; values.mode = rawArgs[++index]; continue;
    }
    if (arg === "--k") {
      if (values.kSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --k");
      values.kSet = true;
      const parsedK = Number(rawArgs[++index]);
      if (!Number.isInteger(parsedK) || parsedK < 1 || parsedK > 50) throw new Error("k must be an integer between 1 and 50");
      values.k = parsedK;
      continue;
    }
    if (arg === "--suite") {
      if (values.suiteSet || index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing or duplicate --suite");
      values.suiteSet = true;
      values.suite = rawArgs[++index];
      continue;
    }
    if (arg === "--check-disjoint") {
      if (index + 1 >= rawArgs.length || rawArgs[index + 1].startsWith("-")) throw new Error("missing --check-disjoint path");
      values.checkDisjoint.push(rawArgs[++index]);
      continue;
    }
    if (arg.startsWith("-")) throw new Error(`unknown option: ${arg}`);
    if (values.command) throw new Error(`unexpected argument: ${arg}`);
    values.command = arg;
  }
  return values;
}

function isInsideRoot(resolvedPath) {
  let target = resolvedPath;
  try { target = realpathSync(resolvedPath); } catch { /* ignore missing path before readFile */ }
  const rel = path.relative(root, target).replace(/\\/g, "/");
  return Boolean(rel && !rel.startsWith("..") && !path.isAbsolute(rel)) ? rel : null;
}

function sanitizeSuiteLabel(resolvedPath, { redactExternal = false } = {}) {
  const rel = isInsideRoot(resolvedPath);
  if (rel) return rel;
  if (redactExternal) return "<external-suite>";
  let target = resolvedPath;
  try { target = realpathSync(resolvedPath); } catch { /* ignore missing path before readFile */ }
  return path.basename(target);
}

export function verifySuiteStratification(label, suite, {
  minCases,
  maxCases,
  expectedRole,
  sourceRepositories = null,
  requiredRepositories = APPROVED_EVAL_REPOSITORIES
} = {}) {
  if (expectedRole && suite.role !== expectedRole) {
    throw new Error(`${label} must declare role="${expectedRole}"`);
  }
  if (minCases !== undefined && maxCases !== undefined) {
    if (suite.cases.length < minCases || suite.cases.length > maxCases) {
      throw new Error(`${label} must contain ${minCases}-${maxCases} cases (got ${suite.cases.length})`);
    }
  }
  if (suite.role === "locked_promotion_exam") {
    if (typeof suite.policy !== "string" || !/Rung 3/i.test(suite.policy) || !/Rung 4/i.test(suite.policy)) {
      throw new Error(`${label} must declare its Rung 3 / Rung 4 locked promotion exam policy`);
    }
  }
  const categories = new Set(suite.cases.map((item) => item.category));
  for (const cat of ALLOWED_CATEGORIES) {
    if (!categories.has(cat)) {
      throw new Error(`${label} is missing required category: ${cat}`);
    }
  }
  if (sourceRepositories) {
    const coveredRepos = new Set();
    for (const item of suite.cases) {
      for (const src of [...(item.sources ?? []), ...(item.anyOfSources ?? []).flat()]) {
        const entry = sourceRepositories.get(src);
        const repo = typeof entry === "string" ? entry : entry?.repository;
        if (repo) coveredRepos.add(repo);
      }
    }
    for (const repo of requiredRepositories) {
      if (!coveredRepos.has(repo)) {
        throw new Error(`${label} is missing repository coverage for ${repo}`);
      }
    }
  }
  return true;
}

export function assertSuitesDisjoint(primarySuite, referenceSuite, {
  primaryLabel = primarySuite?.suite ?? "primary",
  referenceLabel = referenceSuite?.suite ?? "reference"
} = {}) {
  if (!primarySuite?.cases || !referenceSuite?.cases) {
    throw new Error("both suites must provide cases arrays for disjointness verification");
  }
  const refIds = new Set(referenceSuite.cases.map((item) => item.id));
  const refQuestions = new Set(referenceSuite.cases.map((item) => normalizeText(item.question)));
  for (const item of primarySuite.cases) {
    if (refIds.has(item.id)) {
      throw new Error(`duplicate case id across ${primaryLabel} and ${referenceLabel}: ${item.id}`);
    }
    if (refQuestions.has(normalizeText(item.question))) {
      throw new Error(`duplicate question across ${primaryLabel} and ${referenceLabel}: ${item.id}`);
    }
  }
  return true;
}

export function validateSuite(suite, { manifestIds = null, sourceRepositories = null, requireCategories = false } = {}) {
  if (!suite || typeof suite !== "object" || Array.isArray(suite)) {
    throw new Error("evaluation suite must be a JSON object");
  }
  if (!Number.isInteger(suite.version) || suite.version < 1) {
    throw new Error("evaluation suite requires integer version >= 1");
  }
  if (typeof suite.suite !== "string" || !suite.suite.trim()) {
    throw new Error("evaluation suite requires a non-empty suite identifier");
  }
  if (!Array.isArray(suite.cases) || !suite.cases.length) {
    throw new Error("evaluation suite requires a non-empty cases array");
  }
  const enforceV4 = requireCategories || suite.version >= 4 || suite.role === "locked_promotion_exam";
  const seenIds = new Set();
  const seenQuestions = new Set();

  for (const item of suite.cases) {
    if (!item || typeof item !== "object" || Array.isArray(item)) {
      throw new Error("each evaluation case must be an object");
    }
    if (typeof item.id !== "string" || !item.id.trim()) {
      throw new Error("evaluation case requires a non-empty id");
    }
    if (seenIds.has(item.id)) {
      throw new Error(`duplicate evaluation case id: ${item.id}`);
    }
    seenIds.add(item.id);

    if (typeof item.question !== "string" || !item.question.trim()) {
      throw new Error(`case ${item.id}: question must be non-empty`);
    }
    const normalizedQuestion = normalizeText(item.question);
    if (seenQuestions.has(normalizedQuestion)) {
      throw new Error(`case ${item.id}: duplicate question text`);
    }
    seenQuestions.add(normalizedQuestion);

    if (typeof item.abstain !== "boolean") {
      throw new Error(`case ${item.id}: abstain must be boolean`);
    }
    if (item.expectedStatus !== undefined) {
      const expectedForAbstain = item.abstain ? "insufficient_evidence" : "answered";
      if (item.expectedStatus !== expectedForAbstain) {
        throw new Error(`case ${item.id}: expectedStatus must match abstain (${expectedForAbstain})`);
      }
    }
    if (enforceV4 || item.category !== undefined) {
      if (!ALLOWED_CATEGORIES.has(item.category)) {
        throw new Error(`case ${item.id}: invalid or missing category`);
      }
      const isAbstentionCategory = item.category === "honest_abstention" || item.category === "boundary_refusal";
      if (item.abstain !== isAbstentionCategory) {
        throw new Error(`case ${item.id}: category ${item.category} disagrees with abstain=${item.abstain}`);
      }
    }

    if (!Array.isArray(item.facts) || item.facts.some((fact) => typeof fact !== "string" || !fact.trim())) {
      throw new Error(`case ${item.id}: facts must be an array of non-empty strings`);
    }
    if (!item.abstain && enforceV4 && item.facts.length < 2) {
      throw new Error(`case ${item.id}: answerable v4 cases require at least 2 specific facts`);
    }

    if (item.forbiddenFacts !== undefined) {
      if (!Array.isArray(item.forbiddenFacts) || item.forbiddenFacts.some((fact) => typeof fact !== "string" || !fact.trim())) {
        throw new Error(`case ${item.id}: forbiddenFacts must be an array of non-empty strings`);
      }
    }

    const sources = item.sources ?? [];
    if (!Array.isArray(sources) || sources.some((src) => typeof src !== "string" || !src.trim())) {
      throw new Error(`case ${item.id}: sources must be an array of source IDs`);
    }
    const anyOfSources = item.anyOfSources ?? [];
    if (!Array.isArray(anyOfSources) || anyOfSources.some((group) =>
      !Array.isArray(group) || !group.length || group.some((src) => typeof src !== "string" || !src.trim())
    )) {
      throw new Error(`case ${item.id}: anyOfSources must be an array of non-empty source ID arrays`);
    }

    if (item.abstain && (sources.length > 0 || anyOfSources.length > 0)) {
      throw new Error(`case ${item.id}: abstention cases cannot require sources or anyOfSources`);
    }
    if (!item.abstain && sources.length + anyOfSources.length === 0) {
      throw new Error(`case ${item.id}: answerable cases require sources or anyOfSources`);
    }

    if (manifestIds) {
      for (const src of [...sources, ...anyOfSources.flat()]) {
        if (!manifestIds.has(src)) {
          throw new Error(`case ${item.id}: unknown corpus sourceId ${src}`);
        }
      }
    }
  }

  if (suite.role === "locked_promotion_exam") {
    verifySuiteStratification(suite.suite, suite, {
      minCases: 25,
      maxCases: 30,
      expectedRole: "locked_promotion_exam",
      sourceRepositories
    });
  }
  return suite;
}

export async function loadCorpusSources(rootDir = root) {
  const manifest = JSON.parse(await readFile(path.join(rootDir, "corpus", "manifest.json"), "utf8"));
  const map = new Map();
  for (const source of manifest.sources ?? []) {
    const file = path.join(rootDir, ".cache", "dinkus-guide", "sources", `${source.id}.md`);
    const text = await readFile(file, "utf8");
    map.set(source.id, {
      id: source.id,
      repository: source.repository ?? "",
      layer: source.layer ?? (source.repository === "emdash-cms/emdash" ? "emdash" : "dinkuskit"),
      status: source.status ?? "active",
      lines: text.split(/\r?\n/)
    });
  }
  return map;
}

function runCli(cliArgs) {
  return new Promise((resolve) => {
    const child = spawn(process.execPath, [cli, ...cliArgs], { cwd: root, env: process.env });
    let stdout = "", stderr = "";
    child.stdout.on("data", (chunk) => { stdout += chunk; });
    child.stderr.on("data", (chunk) => { stderr += chunk; });
    child.on("close", (code) => {
      let value;
      try { value = JSON.parse(stdout); } catch { value = { status: "error", error: "invalid CLI JSON" }; }
      resolve({ code, value, stderr: stderr.trim() });
    });
  });
}

function runGuide(question, mode, limit = 12) {
  const cliArgs = ["ask", question, "--json", "--mode", mode];
  if (limit !== 12) cliArgs.push("--limit", String(limit));
  return runCli(cliArgs);
}

export function evidenceForCitations(evidence, citations) {
  return (evidence ?? []).filter((item) => (citations ?? []).some((citation) =>
    citation.sourceId === item.sourceId &&
    citation.startLine === item.startLine &&
    citation.endLine === item.endLine));
}

function matchSourcesAndGroups(test, candidateIds) {
  const mandatorySources = test.sources ?? [];
  const sourceGroups = test.anyOfSources ?? [];
  const mandatoryMatched = mandatorySources.filter((source) => candidateIds.includes(source)).length;
  const groupsMatched = sourceGroups.filter((group) => group.some((source) => candidateIds.includes(source))).length;
  const matched = mandatoryMatched + groupsMatched;
  const required = mandatorySources.length + sourceGroups.length;
  return {
    mandatoryMatched,
    mandatoryRequired: mandatorySources.length,
    groupsMatched,
    groupsRequired: sourceGroups.length,
    matched,
    required,
    satisfied: matched === required
  };
}

export function computeRecallCase(test, evidence, k = 12) {
  const topEvidence = (evidence ?? []).slice(0, k);
  const retrievedIds = [...new Set(topEvidence.map((item) => item.sourceId))];
  const sourceMatch = matchSourcesAndGroups(test, retrievedIds);
  const searchable = normalizeText(topEvidence.map((item) => item.excerpt).join("\n"));
  const factsList = test.facts ?? [];
  const factsInEvidence = factsList.filter((fact) => searchable.includes(normalizeText(fact))).length;
  const sourceHit = sourceMatch.satisfied;
  const spanFactHit = factsInEvidence === factsList.length;
  const hit = sourceHit && spanFactHit;
  return {
    id: test.id,
    ...(test.category ? { category: test.category } : {}),
    k,
    sourcesMatched: sourceMatch.matched,
    sourcesRequired: sourceMatch.required,
    groupsMatched: sourceMatch.groupsMatched,
    groupsRequired: sourceMatch.groupsRequired,
    factsInEvidence,
    factsRequired: factsList.length,
    sourceHit,
    spanFactHit,
    hit,
    failureBucket: hit ? null : "retrieval_miss"
  };
}

export function verifyCitationSpan(citation, corpusSources = null) {
  if (!citation || typeof citation !== "object") {
    return { valid: false, reason: "malformed_citation" };
  }
  if (typeof citation.sourceId !== "string" || !citation.sourceId.trim()) {
    return { valid: false, reason: "missing_source_id" };
  }
  if (!Number.isInteger(citation.startLine) || citation.startLine < 1 ||
      !Number.isInteger(citation.endLine) || citation.endLine < citation.startLine) {
    return { valid: false, reason: "invalid_line_range" };
  }
  if (!corpusSources) {
    return { valid: true, text: null };
  }
  const doc = corpusSources.get(citation.sourceId);
  if (!doc) {
    return { valid: false, reason: "unknown_source_id" };
  }
  if (citation.endLine > doc.lines.length) {
    return { valid: false, reason: "line_out_of_bounds" };
  }
  return {
    valid: true,
    text: doc.lines.slice(citation.startLine - 1, citation.endLine).join("\n")
  };
}

export function scoreGuideRun(test, run, { corpusSources = null, recallCase = null } = {}) {
  const value = run?.value ?? {};
  const citations = Array.isArray(value.citations) ? value.citations : [];
  const validCitations = [];
  const invalidCitations = [];
  const citedSpanTexts = [];

  for (const citation of citations) {
    const check = verifyCitationSpan(citation, corpusSources);
    if (check.valid) {
      validCitations.push(citation);
      if (check.text !== null) citedSpanTexts.push(check.text);
    } else {
      invalidCitations.push({
        sourceId: citation?.sourceId ?? null,
        startLine: citation?.startLine ?? null,
        endLine: citation?.endLine ?? null,
        reason: check.reason
      });
    }
  }

  if (!corpusSources) {
    for (const item of evidenceForCitations(value.evidence, validCitations)) {
      citedSpanTexts.push(item.excerpt);
    }
  }

  const validCitedIds = [...new Set(validCitations.map((citation) => citation.sourceId))];
  const sourceMatch = matchSourcesAndGroups(test, validCitedIds);
  const citationSpanValid = test.abstain
    ? citations.length === 0
    : citations.length > 0 && invalidCitations.length === 0;
  const citationPass = test.abstain
    ? citations.length === 0
    : citationSpanValid && sourceMatch.satisfied;

  const rawAnswer = typeof value.answer === "string" ? value.answer : "";
  const answerText = rawAnswer.replace(test.question, "");
  const searchable = normalizeText(`${answerText}\n${citedSpanTexts.join("\n")}`);
  const factsList = test.facts ?? [];
  const matchedFacts = factsList.filter((fact) => searchable.includes(normalizeText(fact)));

  const forbiddenList = test.forbiddenFacts ?? [];
  const extractiveEcho = `Relevant pinned source passages for: ${test.question}`;
  const answerForForbidden = rawAnswer.startsWith(extractiveEcho)
    ? rawAnswer.slice(extractiveEcho.length)
    : rawAnswer;
  const normalizedForbiddenTarget = normalizeText(answerForForbidden);
  const forbiddenMatched = forbiddenList.filter((fact) => normalizedForbiddenTarget.includes(normalizeText(fact)));
  const forbiddenPass = forbiddenMatched.length === 0;
  const forbiddenClaim = !forbiddenPass;
  const factPass = matchedFacts.length === factsList.length && forbiddenPass;

  const expectedStatus = test.expectedStatus ?? (test.abstain ? "insufficient_evidence" : "answered");
  const exitPass = run?.code === 0 && value.status !== "error";
  const abstentionPass = exitPass && value.status === expectedStatus;
  const pass = exitPass && abstentionPass && factPass && citationPass;

  let failureBucket = null;
  if (!pass) {
    if (!exitPass) failureBucket = "schema_error";
    else if (!test.abstain && recallCase && !recallCase.sourceHit) failureBucket = "retrieval_miss";
    else if (!abstentionPass) failureBucket = "abstention_error";
    else if (!citationSpanValid) failureBucket = "citation_miss";
    else if (!factPass) failureBucket = "fact_miss";
    else failureBucket = "citation_miss";
  }

  return {
    id: test.id,
    ...(test.category ? { category: test.category } : {}),
    status: value.status ?? "error",
    expectedStatus,
    factsMatched: matchedFacts.length,
    factsRequired: factsList.length,
    forbiddenMatched,
    forbiddenPass,
    forbiddenClaim,
    citationsMatched: test.abstain ? 0 : sourceMatch.matched,
    citationsRequired: test.abstain ? 0 : sourceMatch.required,
    invalidCitations: invalidCitations.length,
    citationSpanValid,
    abstentionPass,
    citationPass,
    factPass,
    exitCode: run?.code ?? 1,
    pass,
    failureBucket
  };
}

function inferCaseLayer(test, corpusSources) {
  if (test.abstain) return "abstention";
  const allSources = [...(test.sources ?? []), ...(test.anyOfSources ?? []).flat()];
  if (!corpusSources || !allSources.length) return "unknown";
  const layers = new Set();
  for (const src of allSources) {
    const doc = corpusSources.get(src);
    if (doc?.layer) layers.add(doc.layer);
  }
  if (!layers.size) return "unknown";
  return layers.size === 1 ? [...layers][0] : "cross_layer";
}

export function summarizeSuiteResults(cases, results, corpusSources = null) {
  const byId = new Map(cases.map((item) => [item.id, item]));
  const failureBuckets = emptyBucketCounts();
  const byCategory = {};
  const byLayer = {};
  let passed = 0;
  let forbiddenClaims = 0;

  for (const result of results) {
    const isPass = Boolean(result.pass ?? result.hit);
    if (isPass) passed += 1;
    else if (result.failureBucket && Object.hasOwn(failureBuckets, result.failureBucket)) {
      failureBuckets[result.failureBucket] += 1;
    }
    if (result.forbiddenClaim) forbiddenClaims += 1;

    const test = byId.get(result.id);
    const category = result.category ?? test?.category ?? "uncategorized";
    if (!byCategory[category]) {
      byCategory[category] = { total: 0, passed: 0, failed: 0, score: 1, failureBuckets: emptyBucketCounts() };
    }
    byCategory[category].total += 1;
    if (isPass) byCategory[category].passed += 1;
    else {
      byCategory[category].failed += 1;
      if (result.failureBucket && Object.hasOwn(byCategory[category].failureBuckets, result.failureBucket)) {
        byCategory[category].failureBuckets[result.failureBucket] += 1;
      }
    }

    const layer = test ? inferCaseLayer(test, corpusSources) : "unknown";
    if (!byLayer[layer]) {
      byLayer[layer] = { total: 0, passed: 0, failed: 0, score: 1, failureBuckets: emptyBucketCounts() };
    }
    byLayer[layer].total += 1;
    if (isPass) byLayer[layer].passed += 1;
    else {
      byLayer[layer].failed += 1;
      if (result.failureBucket && Object.hasOwn(byLayer[layer].failureBuckets, result.failureBucket)) {
        byLayer[layer].failureBuckets[result.failureBucket] += 1;
      }
    }
  }

  for (const group of [...Object.values(byCategory), ...Object.values(byLayer)]) {
    group.score = group.total ? group.passed / group.total : 1;
  }

  const total = results.length;
  const failed = total - passed;
  return {
    total,
    passed,
    failed,
    score: total ? passed / total : 1,
    failureBuckets,
    forbiddenClaims,
    byCategory,
    byLayer
  };
}

function formatRecallForOutput(recall, summaryOnly) {
  if (!summaryOnly) return recall;
  const { cases: _omitted, ...aggregateRecall } = recall;
  return aggregateRecall;
}

if (isMainModule()) {
  const jsonOutput = args.includes("--json");
  const failUsage = (message) => {
    if (jsonOutput) console.log(JSON.stringify({ status: "error", error: message }));
    else console.error(`dinkus-guide-eval: ${message}`);
    process.exit(2);
  };
  let options;
  try { options = parseArgs(); } catch (error) { failUsage(error.message); }
  if (!args.length) {
    console.log(
      "Usage: dinkus-guide-eval run [--suite eval/cases.json] [--check-disjoint eval/cases.json] " +
      "[--summary-only] [--json] [--mode extractive|model|retrieval|recall] [--k 12]"
    );
    process.exit(0);
  }
  if (options.command === null) failUsage("expected command: run");
  if (options.command !== "run") failUsage(`unexpected command: ${options.command}`);
  if (!["extractive", "model", "retrieval", "recall"].includes(options.mode)) {
    failUsage("mode must be extractive, model, retrieval, or recall");
  }

  const suitePath = options.suite
    ? path.resolve(process.cwd(), options.suite)
    : path.join(root, "eval", "cases.json");
  const suiteFile = sanitizeSuiteLabel(suitePath, { redactExternal: options.summaryOnly });

  let rawSuiteText;
  try {
    rawSuiteText = await readFile(suitePath, "utf8");
  } catch (error) {
    failUsage(`invalid suite (${suiteFile}): ${error?.code === "ENOENT" ? "suite file not found" : "unable to read suite file"}`);
  }
  const suiteSha256 = sha256Text(rawSuiteText);

  let suite;
  try {
    let parsedSuite;
    try { parsedSuite = JSON.parse(rawSuiteText); } catch { throw new Error("suite is not valid JSON"); }
    suite = validateSuite(parsedSuite);
  } catch (error) {
    failUsage(`invalid suite (${suiteFile}): ${error.message}`);
  }

  const disjointFrom = [];
  for (const rawRef of options.checkDisjoint) {
    const refPath = path.resolve(process.cwd(), rawRef);
    const refLabel = sanitizeSuiteLabel(refPath, { redactExternal: options.summaryOnly });
    let rawRefText;
    try {
      rawRefText = await readFile(refPath, "utf8");
    } catch (error) {
      failUsage(`invalid disjoint reference (${refLabel}): ${error?.code === "ENOENT" ? "suite file not found" : "unable to read suite file"}`);
    }
    try {
      let parsedRef;
      try { parsedRef = JSON.parse(rawRefText); } catch { throw new Error("suite is not valid JSON"); }
      const refSuite = validateSuite(parsedRef);
      assertSuitesDisjoint(suite, refSuite, { primaryLabel: suite.suite, referenceLabel: refSuite.suite });
      disjointFrom.push({
        suite: refSuite.suite,
        suiteFile: refLabel,
        suiteSha256: sha256Text(rawRefText),
        cases: refSuite.cases.length
      });
    } catch (error) {
      failUsage(`disjointness check failed (${refLabel}): ${error.message}`);
    }
  }

  const corpusRun = await runCli(["corpus", "verify", "--json"]);
  if (corpusRun.code !== 0) {
    const report = {
      suite: suite.suite,
      suiteFile,
      suiteVersion: suite.version,
      suiteSha256,
      ...(suite.role ? { suiteRole: suite.role } : {}),
      ...(options.summaryOnly ? { summaryOnly: true } : {}),
      ...(disjointFrom.length ? { disjointFrom } : {}),
      mode: options.mode,
      availability: "unavailable",
      reason: corpusRun.value.error || corpusRun.stderr,
      total: suite.cases.length,
      passed: 0,
      failed: 0,
      score: null,
      ...(options.summaryOnly ? {} : { results: [] })
    };
    console.log(options.json ? JSON.stringify(report) : `unavailable: ${report.reason}`);
    process.exit(2);
  }

  const corpusSources = await loadCorpusSources(root);
  try {
    validateSuite(suite, {
      manifestIds: new Set(corpusSources.keys()),
      sourceRepositories: corpusSources
    });
  } catch (error) {
    failUsage(`invalid suite (${suiteFile}): ${error.message}`);
  }

  // Step 1: Standalone retrieval recall@k before any model synthesis runs
  const extractiveRuns = [];
  const recallCases = [];
  const recallById = new Map();
  for (const test of suite.cases) {
    const run = await runGuide(test.question, "extractive", options.k);
    if ((run.code === 3 || run.code === 4) && providerUnavailableError.test(run.value.error || "")) {
      const report = {
        suite: suite.suite,
        suiteFile,
        suiteVersion: suite.version,
        suiteSha256,
        ...(suite.role ? { suiteRole: suite.role } : {}),
        ...(options.summaryOnly ? { summaryOnly: true } : {}),
        ...(disjointFrom.length ? { disjointFrom } : {}),
        mode: options.mode,
        availability: "unavailable",
        reason: run.value.error,
        total: suite.cases.length,
        passed: 0,
        failed: 0,
        score: null,
        ...(options.summaryOnly ? {} : { results: [] })
      };
      console.log(options.json ? JSON.stringify(report) : `unavailable: ${report.reason}`);
      process.exit(2);
    }
    extractiveRuns.push({ test, run });
    if (!test.abstain) {
      const rc = computeRecallCase(test, run.value.evidence, options.k);
      recallCases.push(rc);
      recallById.set(test.id, rc);
    }
  }

  const sourceHits = recallCases.filter((item) => item.sourceHit).length;
  const spanHits = recallCases.filter((item) => item.hit).length;
  const recall = {
    k: options.k,
    eligible: recallCases.length,
    sourceHits,
    sourceRecallAtK: recallCases.length ? sourceHits / recallCases.length : 1,
    hits: spanHits,
    recallAtK: recallCases.length ? spanHits / recallCases.length : 1,
    cases: recallCases
  };

  if (!options.json) {
    console.log(`recall@${options.k}: ${spanHits}/${recallCases.length} (${(recall.recallAtK * 100).toFixed(1)}%), sourceRecall@${options.k}: ${sourceHits}/${recallCases.length} (${(recall.sourceRecallAtK * 100).toFixed(1)}%)`);
  }

  if (options.mode === "retrieval" || options.mode === "recall") {
    const answerableCases = suite.cases.filter((item) => !item.abstain);
    const summary = summarizeSuiteResults(answerableCases, recallCases, corpusSources);
    const report = {
      suite: suite.suite,
      suiteFile,
      suiteVersion: suite.version,
      suiteSha256,
      ...(suite.role ? { suiteRole: suite.role } : {}),
      ...(options.summaryOnly ? { summaryOnly: true } : {}),
      ...(disjointFrom.length ? { disjointFrom } : {}),
      mode: options.mode,
      availability: "available",
      corpusHash: corpusRun.value.corpusHash ?? null,
      total: summary.total,
      passed: summary.passed,
      failed: summary.failed,
      score: summary.score,
      failureBuckets: summary.failureBuckets,
      forbiddenClaims: 0,
      byCategory: summary.byCategory,
      byLayer: summary.byLayer,
      recall: formatRecallForOutput(recall, options.summaryOnly),
      ...(options.summaryOnly ? {} : { results: recall.cases })
    };
    if (options.json) console.log(JSON.stringify(report));
    process.exit(recall.hits === recall.eligible ? 0 : 1);
  }

  // Step 2: Score extractive or run Worker B model synthesis
  const results = [];
  const modelIdentities = new Set();
  if (options.mode === "extractive") {
    for (const { test, run } of extractiveRuns) {
      results.push(scoreGuideRun(test, run, { corpusSources, recallCase: recallById.get(test.id) ?? null }));
    }
  } else {
    for (const test of suite.cases) {
      const run = await runGuide(test.question, "model", options.k);
      const value = run.value;
      if (value.modelIdentity) modelIdentities.add(value.modelIdentity);
      if ((run.code === 3 || run.code === 4) && providerUnavailableError.test(value.error || "")) {
        const report = {
          suite: suite.suite,
          suiteFile,
          suiteVersion: suite.version,
          suiteSha256,
          ...(suite.role ? { suiteRole: suite.role } : {}),
          ...(options.summaryOnly ? { summaryOnly: true } : {}),
          ...(disjointFrom.length ? { disjointFrom } : {}),
          mode: options.mode,
          availability: "unavailable",
          reason: value.error,
          recall: formatRecallForOutput(recall, options.summaryOnly),
          total: suite.cases.length,
          passed: 0,
          failed: 0,
          score: null,
          ...(options.summaryOnly ? {} : { results: [] })
        };
        console.log(options.json ? JSON.stringify(report) : `unavailable: ${report.reason}`);
        process.exit(2);
      }
      results.push(scoreGuideRun(test, run, { corpusSources, recallCase: recallById.get(test.id) ?? null }));
    }
  }

  const summary = summarizeSuiteResults(suite.cases, results, corpusSources);
  const subscores = {
    abstentionPassed: results.filter((r) => r.abstentionPass).length,
    citationSpanValid: results.filter((r) => r.citationSpanValid).length,
    citationPassed: results.filter((r) => r.citationPass).length,
    factPassed: results.filter((r) => r.factPass).length,
    forbiddenPassed: results.filter((r) => r.forbiddenPass).length
  };
  const report = {
    suite: suite.suite,
    suiteFile,
    suiteVersion: suite.version,
    suiteSha256,
    ...(suite.role ? { suiteRole: suite.role } : {}),
    ...(options.summaryOnly ? { summaryOnly: true } : {}),
    ...(disjointFrom.length ? { disjointFrom } : {}),
    mode: options.mode,
    availability: "available",
    modelIdentity: options.mode === "model" ? [...modelIdentities] : undefined,
    corpusHash: corpusRun.value.corpusHash ?? null,
    recall: formatRecallForOutput(recall, options.summaryOnly),
    total: summary.total,
    passed: summary.passed,
    failed: summary.failed,
    score: summary.score,
    failureBuckets: summary.failureBuckets,
    forbiddenClaims: summary.forbiddenClaims,
    subscores,
    byCategory: summary.byCategory,
    byLayer: summary.byLayer,
    ...(options.summaryOnly ? {} : { results })
  };
  if (options.json) {
    console.log(JSON.stringify(report));
  } else {
    console.log(`${summary.passed}/${summary.total} passed (${(report.score * 100).toFixed(1)}%) in ${options.mode} mode`);
    console.log(
      `buckets: retrieval_miss=${summary.failureBuckets.retrieval_miss} schema_error=${summary.failureBuckets.schema_error} ` +
      `abstention_error=${summary.failureBuckets.abstention_error} citation_miss=${summary.failureBuckets.citation_miss} ` +
      `fact_miss=${summary.failureBuckets.fact_miss} (forbiddenClaims=${summary.forbiddenClaims})`
    );
  }
  process.exit(summary.passed === summary.total ? 0 : 1);
}
