#!/usr/bin/env node
import { createAskService } from "../src/ask-service.js";

// Intentionally loopback-only. TLS ingress and public exposure are separate operator actions.
try {
  const port = Number(process.env.DINKUS_GUIDE_SERVICE_PORT ?? 8789);
  if (!Number.isInteger(port) || port < 1 || port > 65535) throw new Error("Invalid port");
  const names = { questionCharacters: "QUESTION_CHARACTERS", bodyBytes: "BODY_BYTES", responseBytes: "RESPONSE_BYTES",
    durationMs: "DURATION_MS", concurrency: "CONCURRENCY", queueSize: "QUEUE_SIZE", requestsPerMinute: "REQUESTS_PER_MINUTE" };
  const limits = Object.fromEntries(Object.entries(names).filter(([, name]) => process.env[`DINKUS_GUIDE_SERVICE_${name}`] !== undefined)
    .map(([key, name]) => [key, Number(process.env[`DINKUS_GUIDE_SERVICE_${name}`])]));
  const server = await createAskService({ token: process.env.DINKUS_GUIDE_SERVICE_TOKEN, limits });
  server.on("error", () => { console.error("Guide service unavailable"); process.exitCode = 1; });
  server.listen(port, "127.0.0.1", () => console.log("Guide ask service listening on loopback"));
  for (const signal of ["SIGTERM", "SIGINT"]) process.once(signal, () => server.close());
} catch {
  console.error("Guide service configuration unavailable");
  process.exitCode = 1;
}
